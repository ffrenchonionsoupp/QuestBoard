<?xml version="1.0" encoding="UTF-8" ?>
<Shell  
    x:Class="MAUI_QuestBoard.AppShell"  
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
    xmlns:pages="clr-namespace:MAUI_QuestBoard.Pages"
    FlyoutBehavior="Disabled"
    Title="MAUI_QuestBoard">

    <!-- Startup Page -->
    <ShellContent  
        ContentTemplate="{DataTemplate pages:LoginPage}"  
        Route="LoginPage" />

    <!-- TabBar for main navigation -->
    <TabBar>
        <ShellContent Route="QuestBoardPage" ContentTemplate="{DataTemplate pages:QuestBoardPage}" />
        <ShellContent Route="MyAdventuresPage" ContentTemplate="{DataTemplate pages:MyAdventuresPage}" />
        <ShellContent Route="MyQuestsPage" ContentTemplate="{DataTemplate pages:MyQuestsPage}" />
        <ShellContent Route="AdminPage" ContentTemplate="{DataTemplate pages:AdminPage}" IsVisible="{Binding IsAdmin}" />
    </TabBar>
</Shell>
