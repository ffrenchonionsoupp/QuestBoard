<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.AddEventPage"
             Title="Add Event">

    <ContentPage.BindingContext>
        <vm:AddEventViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Label Text="Add Event" Style="{StaticResource NavTitle}" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Border Padding="18">
                <VerticalStackLayout Spacing="10">

                    <Entry Placeholder="Event Name" Text="{Binding Name}" />
                    <Entry Placeholder="Host Name" Text="{Binding Host}" />
                    <Entry Placeholder="Event Address" Text="{Binding Address}" />
                    <Entry Placeholder="Max Attendees" Text="{Binding Max}" Keyboard="Numeric" />

                    <Label Text="Event Date and Time" Style="{StaticResource BoldLabel}" Margin="0,10,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <DatePicker Grid.Column="0" Date="{Binding EventDate}" MinimumDate="{Binding MinEventDate}" />
                        <TimePicker Grid.Column="1" Time="{Binding EventTime}" />
                    </Grid>

                    <Label Text="RSVP Deadline (Date and Time)" Style="{StaticResource BoldLabel}" Margin="0,10,0,0" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <DatePicker Grid.Column="0" Date="{Binding DeadlineDate}" />
                        <TimePicker Grid.Column="1" Time="{Binding DeadlineTime}" />
                    </Grid>

                    <!-- Sits above the buttons so it is always on screen when it appears -->
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />

                    <Button Text="Save" Command="{Binding SaveCommand}" />
                    <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
