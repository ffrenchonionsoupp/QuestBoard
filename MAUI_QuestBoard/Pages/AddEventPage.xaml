<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.AddEventPage">

    <ContentPage.BindingContext>
        <vm:AddEventViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="10">

        <Entry Placeholder="Event Name" Text="{Binding Name}" />
        <Entry Placeholder="Host Name" Text="{Binding Host}" />
        <Entry Placeholder="Location" Text="{Binding Location}" />
        <Entry Placeholder="Max Attendees" Text="{Binding Max}" />
        <Entry Placeholder="Date" Text="{Binding Date}" />
        <Entry Placeholder="RSVP Deadline" Text="{Binding Deadline}" />

        <Button Text="Save" Command="{Binding SaveCommand}" />
        <Button Text="Cancel" Command="{Binding CancelCommand}" />

        <Label Text="{Binding Error}" TextColor="Red" />

    </VerticalStackLayout>
</ContentPage>
