<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.AdminPage"
             Title="Admin">

    <ContentPage.BindingContext>
        <vm:AdminViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Label Text="Admin" Style="{StaticResource NavTitle}" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Confirmations (e.g. "path copied") and problems show here -->
            <Label Text="{Binding InfoMessage}" IsVisible="{Binding HasInfo}" Style="{StaticResource InfoLabel}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />

            <!-- ===== Database ===== -->
            <Label Text="Database (SQLite)" Style="{StaticResource SectionHeading}" />
            <Border Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding FileName, StringFormat='File: {0}'}" />
                    <Label Text="Location (select to copy by hand, or use Copy Path):" />
                    <Entry Text="{Binding FilePath}" IsReadOnly="True" />
                    <Label Text="{Binding FileExists, StringFormat='File exists: {0}'}" />
                    <Label Text="{Binding FileSize, StringFormat='Size: {0}'}" />
                    <Label Text="{Binding LastModified, StringFormat='Last modified: {0}'}" />
                    <Label Text="{Binding OpenFlags, StringFormat='Open flags: {0}'}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Copy Path" Command="{Binding CopyPathCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Open Folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="2" Text="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Label Text="Tables" Style="{StaticResource SectionHeading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tables}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Connections opened this session" Style="{StaticResource SectionHeading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Connections}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ===== Registered accounts ===== -->
            <Label Text="Registered users" Style="{StaticResource SectionHeading}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Users}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" Style="{StaticResource BoldLabel}" />
                                <Label Text="{Binding Email}" />
                                <Label Text="{Binding Phone}" />
                                <Border Style="{StaticResource BadgeBorder}" Margin="0,4,0,0">
                                    <Label Text="{Binding Role}" Style="{StaticResource BadgeLabel}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Back to Quest Board" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" Margin="0,15,0,0" />
            <Button Text="Log Out" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
