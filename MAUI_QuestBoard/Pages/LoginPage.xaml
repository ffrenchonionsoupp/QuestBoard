<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.LoginPage"
             Title="Login">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Label Text="Login" Style="{StaticResource NavTitle}" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Application logo: Cinzel Bold -->
            <Label Text="QuestBoard" Style="{StaticResource LogoLabel}" Margin="0,24,0,0" />

            <Border Padding="18">
                <VerticalStackLayout Spacing="12">
                    <!-- These UI elements are bound to the properties in the LoginViewModel -->
                    <Entry Text="{Binding Email}" Placeholder="Email Address" Keyboard="Email" />
                    <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />

                    <Button Text="Login" Command="{Binding LoginCommand}" />
                    <Button Text="Continue as Guest" Command="{Binding ContinueAsGuestCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Text="Create Account" Command="{Binding CreateAccountCommand}" Style="{StaticResource SecondaryButton}" />

                    <Label Text="{Binding Message}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
