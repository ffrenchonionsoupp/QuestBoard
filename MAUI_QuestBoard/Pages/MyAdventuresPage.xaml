<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.MyAdventuresPage"
             Title="My Adventures">

    <ContentPage.BindingContext>
        <vm:MyAdventuresViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Label Text="My Adventures" Style="{StaticResource NavTitle}" />
    </Shell.TitleView>

    <Grid>

        <!-- Shown only when browsing as a guest -->
        <VerticalStackLayout IsVisible="{Binding IsGuest}"
                              VerticalOptions="Center"
                              Padding="30"
                              Spacing="15">
            <Label Text="You're browsing as a guest."
                   Style="{StaticResource BoldLabel}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Create an account to see the events you RSVP to here."
                   HorizontalTextAlignment="Center" />
            <Button Text="Create Account" Command="{Binding CreateAccountCommand}" />
        </VerticalStackLayout>

        <!-- Shown only when logged in -->
        <CollectionView ItemsSource="{Binding Events}"
                        IsVisible="{Binding IsGuest, Converter={StaticResource InvertedBoolConverter}}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="10,6">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Name}" Style="{StaticResource EventTitle}" />
                            <Label Text="{Binding Address}" />
                            <Label Text="{Binding Date}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="You haven't RSVP'd to any events yet."
                           Style="{StaticResource BoldLabel}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Open the Quest Board tab to find an event to attend."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>
