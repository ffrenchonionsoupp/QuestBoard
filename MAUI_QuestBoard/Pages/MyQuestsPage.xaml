<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.MyQuestsPage">

    <ContentPage.BindingContext>
        <vm:MyQuestsViewModel />
    </ContentPage.BindingContext>

    <Grid>

        <!-- Shown only when browsing as a guest -->
        <VerticalStackLayout IsVisible="{Binding IsGuest}"
                              VerticalOptions="Center"
                              Padding="30"
                              Spacing="15">
            <Label Text="You're browsing as a guest."
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Create an account to host and track your own events here."
                   HorizontalTextAlignment="Center" />
            <Button Text="Create Account" Command="{Binding CreateAccountCommand}" />
        </VerticalStackLayout>

        <!-- Shown only when logged in -->
        <CollectionView ItemsSource="{Binding Events}"
                        IsVisible="{Binding IsGuest, Converter={StaticResource InvertedBoolConverter}}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="10" BorderColor="DarkGreen">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Location}" />
                            <Label Text="{Binding Date}" />
                            <Label Text="Hosted Event" TextColor="Goldenrod" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
