<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.MyQuestsPage">

    <ContentPage.BindingContext>
        <vm:MyQuestsViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding Events}"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="10" BorderColor="DarkGreen">
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding Location}" />
                        <Label Text="{Binding Date}" />
                        <Label Text="Hosted Event" TextColor="Goldenrod" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>
