<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels;assembly=MAUI_QuestBoard"
             xmlns:models="clr-namespace:MAUI_QuestBoard.Models;assembly=MAUI_QuestBoard"
             x:Class="MAUI_QuestBoard.Pages.QuestBoardPage"
             x:DataType="vm:QuestBoardViewModel"
             Title="Quest Board">

    <ContentPage.BindingContext>
        <vm:QuestBoardViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Label Text="Quest Board" Style="{StaticResource NavTitle}" />
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <FlexLayout Grid.Row="0"
                    Wrap="Wrap"
                    JustifyContent="SpaceEvenly"
                    Padding="10">
            <Button Text="My Adventures" Command="{Binding NavigateToMyAdventuresCommand}" Style="{StaticResource SecondaryButton}" Margin="4" />
            <Button Text="My Quests" Command="{Binding NavigateToMyQuestsCommand}" Style="{StaticResource SecondaryButton}" Margin="4" />
            <Button Text="Add Event" Command="{Binding NavigateToAddEventCommand}" Margin="4" />
            <Button Text="Admin" Command="{Binding NavigateToAdminCommand}" IsVisible="{Binding IsAdmin}" Style="{StaticResource SecondaryButton}" Margin="4" />
            <Button Text="Log Out" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" Margin="4" />
        </FlexLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Events}"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Event">
                    <Border Padding="14" Margin="10,6">
                        <VerticalStackLayout Spacing="2">
                            <!-- Event titles: Cinzel -->
                            <Label Text="{Binding Name}" Style="{StaticResource EventTitle}" />
                            <Label Text="{Binding Address}" />
                            <Label Text="{Binding Date}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
