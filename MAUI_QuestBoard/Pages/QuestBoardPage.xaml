<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels;assembly=MAUI_QuestBoard"
             x:Class="MAUI_QuestBoard.Pages.QuestBoardPage">

    <ContentPage.BindingContext>
        <vm:QuestBoardViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding Events}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedEvent}"
                    SelectionChanged="OnSelectionChanged"
                    x:DataType="vm:QuestBoardViewModel">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="10" Margin="10" Stroke="DarkGreen">
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding Location}" />
                        <Label Text="{Binding Date}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>
