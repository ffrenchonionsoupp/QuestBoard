<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI_QuestBoard.ViewModels"
             x:Class="MAUI_QuestBoard.Pages.RSVPPage"
             Title="RSVP">

    <ContentPage.BindingContext>
        <vm:RSVPViewModel />
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Label Text="RSVP" Style="{StaticResource NavTitle}" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Border Padding="18">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding SelectedEvent.Name}" Style="{StaticResource EventTitle}" FontSize="22" />

                    <Entry Placeholder="Your Name" Text="{Binding Name}" />
                    <Entry Placeholder="Your Email" Text="{Binding Email}" Keyboard="Email" />
                    <Entry Placeholder="Your Phone" Text="{Binding Phone}" Keyboard="Telephone" />

                    <!-- Sits above the buttons so it is always on screen when it appears -->
                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />

                    <Button Text="Save RSVP" Command="{Binding SaveCommand}" />
                    <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
