<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- QuestBoard color palette (Design Document, section 14) -->

    <!-- Forest Green: primary buttons, navigation, headings -->
    <Color x:Key="ForestGreen">#344E41</Color>
    <!-- Moss Green: secondary elements and hover states -->
    <Color x:Key="MossGreen">#588157</Color>
    <!-- Parchment: primary page background -->
    <Color x:Key="Parchment">#F2E8CF</Color>
    <!-- Soft Cream: cards and form backgrounds -->
    <Color x:Key="SoftCream">#FFFDF5</Color>
    <!-- Warm Brown: text, borders, and accents -->
    <Color x:Key="WarmBrown">#432818</Color>
    <!-- Tavern Gold: highlights, badges, active navigation (used as a fill or
         accent - gold text on Parchment is too low-contrast to read) -->
    <Color x:Key="TavernGold">#D4A72C</Color>
    <!-- Muted Burgundy: warnings and destructive actions -->
    <Color x:Key="MutedBurgundy">#8B3A3A</Color>

    <!-- Warm Brown at about 60% opacity, for placeholder text -->
    <Color x:Key="WarmBrownMuted">#99432818</Color>

    <SolidColorBrush x:Key="ForestGreenBrush" Color="{StaticResource ForestGreen}" />
    <SolidColorBrush x:Key="MossGreenBrush" Color="{StaticResource MossGreen}" />
    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource Parchment}" />
    <SolidColorBrush x:Key="SoftCreamBrush" Color="{StaticResource SoftCream}" />
    <SolidColorBrush x:Key="WarmBrownBrush" Color="{StaticResource WarmBrown}" />
    <SolidColorBrush x:Key="TavernGoldBrush" Color="{StaticResource TavernGold}" />
    <SolidColorBrush x:Key="MutedBurgundyBrush" Color="{StaticResource MutedBurgundy}" />
</ResourceDictionary>
