<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================= Typography (Design Document, section 15) =================
         Heading font: Cinzel   |   Body font: Nunito
         The names below are the aliases registered in MauiProgram.cs. -->
    <x:String x:Key="HeadingFontBold">CinzelBold</x:String>
    <x:String x:Key="HeadingFontSemiBold">CinzelSemiBold</x:String>
    <x:String x:Key="HeadingFont">CinzelRegular</x:String>
    <x:String x:Key="BodyFont">NunitoRegular</x:String>
    <x:String x:Key="BodyFontBold">NunitoBold</x:String>

    <!-- ================= Pages ================= -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
    </Style>

    <!-- Navigation bar = Forest Green, active tab = Tavern Gold -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource SoftCream}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource SoftCream}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource MossGreen}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource SoftCream}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource TavernGold}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource TavernGold}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource SoftCream}" />
    </Style>

    <!-- ================= Text ================= -->
    <!-- Body text: Nunito, Warm Brown -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Application logo: Cinzel Bold -->
    <Style x:Key="LogoLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFontBold}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Page title shown in the navigation bar: Cinzel Semi-Bold on Forest Green -->
    <Style x:Key="NavTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource SoftCream}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFontSemiBold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Section headings inside a page: Cinzel Semi-Bold -->
    <Style x:Key="SectionHeading" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFontSemiBold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- Event titles: Cinzel -->
    <Style x:Key="EventTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Emphasized body text: the real Nunito Bold file (not a faux-bold) -->
    <Style x:Key="BoldLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Warnings and validation messages: Muted Burgundy -->
    <Style x:Key="ErrorLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedBurgundy}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Confirmations / information: Forest Green -->
    <Style x:Key="InfoLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Text that sits on a Tavern Gold badge -->
    <Style x:Key="BadgeLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Kept because the unused template MainPage.xaml refers to them -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFontBold}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFontSemiBold}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ================= Buttons: Nunito Bold ================= -->
    <!-- Primary: Forest Green (Moss Green on hover/press) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource SoftCream}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFontBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource MossGreen}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource MossGreen}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Every button is primary unless it asks for the secondary style -->
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

    <!-- Secondary: Moss Green (Forest Green on hover/press) - Cancel, Back, etc. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource MossGreen}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ForestGreen}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================= Forms: Nunito, Warm Brown on Parchment inputs ================= -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource WarmBrownMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource WarmBrownMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource WarmBrown}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ================= Cards and badges ================= -->
    <!-- Cards and form backgrounds: Soft Cream with a Warm Brown border -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SoftCream}" />
        <Setter Property="Stroke" Value="{StaticResource WarmBrownBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small highlight pill: Tavern Gold fill, Warm Brown text on top -->
    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TavernGold}" />
        <Setter Property="Stroke" Value="{StaticResource TavernGoldBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>
</ResourceDictionary>
